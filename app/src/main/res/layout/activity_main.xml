<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="60dp"
    android:paddingBottom="24dp"
    android:background="#F4F6F8">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simple Calculator"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <EditText
        android:id="@+id/first_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter first number"
        android:inputType="numberDecimal|numberSigned"
        android:textSize="18sp"
        android:textColor="#111827"
        android:textColorHint="#6B7280"
        android:backgroundTint="#374151"
        android:padding="12dp" />

    <EditText
        android:id="@+id/second_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter second number"
        android:inputType="numberDecimal|numberSigned"
        android:textSize="18sp"
        android:textColor="#111827"
        android:textColorHint="#6B7280"
        android:backgroundTint="#374151"
        android:padding="12dp"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="26dp">

        <Button
            android:id="@+id/add_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="ADD"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F4E79"
            android:onClick="addNumbers" />

        <Button
            android:id="@+id/sub_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="SUB"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5B6770"
            android:onClick="subNumbers"
            android:layout_marginLeft="12dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/div_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="DIV"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7A3E3E"
            android:onClick="divNumbers" />

        <Button
            android:id="@+id/mul_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="MUL"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5A4A78"
            android:onClick="mulNumbers"
            android:layout_marginLeft="12dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/result_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Result"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginTop="28dp"
        android:background="#E5E7EB" />

    <Button
        android:id="@+id/show_result_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="SHOW RESULT"
        android:textColor="#FFFFFF"
        android:backgroundTint="#111827"
        android:onClick="openResultActivity"
        android:layout_marginTop="24dp" />

</LinearLayout>